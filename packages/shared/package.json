{
  "name": "@vnpolice/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "postbuild": "node scripts/write-module-markers.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.esm.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
